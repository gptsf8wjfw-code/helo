<!DOCTYPE html>

<html lang="vi">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>DPI FF 👑</title>

<style>

* {

    box-sizing: border-box;

    font-family: Arial, sans-serif;

}

body {

    margin: 0;

    min-height: 100vh;

    background: linear-gradient(135deg, #050505, #171717, #050505);

    color: white;

    display: flex;

    justify-content: center;

    align-items: center;

}

.box {

    width: 92%;

    max-width: 420px;

    padding: 25px;

    border-radius: 22px;

    background: rgba(20,20,20,.95);

    box-shadow: 0 0 30px rgba(255,0,0,.25);

    border: 1px solid #333;

}

h1 {

    text-align: center;

    margin-top: 0;

    font-size: 30px;

}

.logo {

    text-align: center;

    font-size: 42px;

    margin-bottom: 5px;

}

label {

    display: block;

    margin-top: 17px;

    margin-bottom: 7px;

    font-weight: bold;

}

select,

input {

    width: 100%;

    padding: 13px;

    border-radius: 12px;

    border: 1px solid #444;

    background: #0b0b0b;

    color: white;

    outline: none;

    font-size: 15px;

}

input[type="range"] {

    padding: 0;

}

.value {

    text-align: center;

    margin-top: 6px;

    font-size: 14px;

    color: #aaa;

}

button {

    width: 100%;

    margin-top: 25px;

    padding: 15px;

    border: 0;

    border-radius: 14px;

    color: white;

    font-weight: bold;

    font-size: 17px;

    cursor: pointer;

    background: linear-gradient(90deg,#ff0000,#ff7300,#ff00c8);

    box-shadow: 0 0 20px rgba(255,0,100,.35);

}

button:active {

    transform: scale(.97);

}

#status {

    display: none;

    margin-top: 22px;

    text-align: center;

    font-size: 17px;

    font-weight: bold;

    animation: rainbow 2s linear infinite;

}

@keyframes rainbow {

    0% {color:red;}

    16% {color:orange;}

    33% {color:yellow;}

    50% {color:lime;}

    66% {color:#00eaff;}

    83% {color:#8b5cff;}

    100% {color:#ff00d4;}

}

.info {

    margin-top: 15px;

    padding: 12px;

    border-radius: 12px;

    background: #0b0b0b;

    color: #999;

    font-size: 12px;

    text-align: center;

}

</style>

</head>

<body>

<div class="box">

    <div class="logo">👑</div>

    <h1>DPI FF TOOL</h1>

    <label>📱 Chọn dòng máy</label>

    <select id="device">

        <option>iPhone 6</option>

        <option>iPhone 7 / 8</option>

        <option>iPhone X / XS</option>

        <option>iPhone 11</option>

        <option>iPhone 12 / 12 Pro</option>

        <option>iPhone 12 Pro Max</option>

        <option>iPhone 13</option>

        <option>iPhone 14</option>

        <option>iPhone 15</option>

        <option>iPhone 16</option>

        <option>Android</option>

        <option>Samsung</option>

        <option>Xiaomi</option>

        <option>OPPO</option>

    </select>

    <label>🎯 DPI</label>

    <input type="range" id="dpi" min="300" max="1200" value="600"

           oninput="updateValue('dpi','dpiValue')">

    <div class="value">DPI: <span id="dpiValue">600</span></div>

    <label>🎮 Hỗ trợ kéo tâm</label>

    <input type="range" id="aim" min="1" max="100" value="85"

           oninput="updateValue('aim','aimValue')">

    <div class="value">Mức hỗ trợ: <span id="aimValue">85</span>%</div>

    <label>⚡ Độ mượt</label>

    <input type="range" id="smooth" min="1" max="100" value="90"

           oninput="updateValue('smooth','smoothValue')">

    <div class="value">Độ mượt: <span id="smoothValue">90</span>%</div>

    <button onclick="activate()">👑 KÍCH HOẠT DPI</button>

    <div id="status">

        ĐÃ KÍCH HOẠT DPI HỖ TRỢ KÉO TÂM 👑

    </div>

    <div class="info">

        ⚠️ Đây là giao diện mô phỏng hỗ trợ cài đặt.

        Không can thiệp hoặc chỉnh sửa trực tiếp game.

    </div>

</div>

<script>

function updateValue(input, output) {

    document.getElementById(output).innerText =

        document.getElementById(input).value;

}

function activate() {

    const device = document.getElementById("device").value;

    const dpi = document.getElementById("dpi").value;

    const aim = document.getElementById("aim").value;

    const smooth = document.getElementById("smooth").value;

    const status = document.getElementById("status");

    status.style.display = "block";

    status.innerHTML =

        "ĐÃ KÍCH HOẠT DPI HỖ TRỢ KÉO TÂM 👑<br>" +

        "<small>" +

        device + " • DPI " + dpi +

        " • Kéo tâm " + aim +

        "% • Mượt " + smooth + "%" +

        "</small>";

}

</script>

</body>

</html>
